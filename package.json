{
  "name": "ooxml-validate",
  "version": "0.0.5",
  "description": "Validate OOXML documents (pptx, xlsx, docx) against the Open XML SDK schema validator, from Node.",
  "license": "MIT",
  "author": "shbernal",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/ooxml-validate.git"
  },
  "homepage": "https://github.com/shbernal/ooxml-validate#readme",
  "bugs": {
    "url": "https://github.com/shbernal/ooxml-validate/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ooxml-validate": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src scripts test && oxfmt --check src scripts test",
    "lint:fix": "oxlint --fix src scripts test && oxfmt src scripts test",
    "format": "oxfmt src scripts test",
    "test": "node --test \"test/**/*.test.ts\"",
    "oracle:build": "dotnet build oracle/OoxmlValidate.csproj -c Release",
    "oracle:test": "dotnet test --project oracle.tests/OoxmlValidate.Tests.csproj",
    "oracle:snapshot": "OOXML_VALIDATE_UPDATE_SNAPSHOT=1 dotnet test --project oracle.tests/OoxmlValidate.Tests.csproj",
    "test:integration": "pnpm run oracle:build && OOXML_VALIDATE_BIN=\"$PWD/oracle/bin/Release/net10.0/ooxml-validate\" pnpm test",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "ooxml",
    "validation",
    "openxml",
    "pptx",
    "xlsx",
    "docx",
    "office-open-xml",
    "schema"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  }
}

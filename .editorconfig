# EditorConfig — baseline for editors and agents writing files that fall outside
# the formatter's reach. Biome owns src/, scripts/ and test/ (see the `format`
# script in package.json); everything else — Markdown, YAML, the .NET sources,
# most config — relies on this.
#
# Duplicate, not derive: Biome does not read .editorconfig by default, so nothing
# enforces the agreement between this file and biome.json. When a formatting
# option changes in biome.json, change it here in the same commit.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Mirrors biome.json (`indentStyle: space`, `indentWidth: 2`, `lineWidth: 100`).
[*.{ts,js,mjs,json,jsonc}]
indent_style = space
indent_size = 2
max_line_length = 100

# C# follows the .NET convention, not the JS one.
[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

# Markdown: keep trailing whitespace — two trailing spaces is a hard line break.
[*.md]
trim_trailing_whitespace = false
